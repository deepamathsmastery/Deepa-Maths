<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Badges &amp; Achievements (சாதனைப் பதக்கங்கள்)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Badge 1: Beginner Star -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ தொடக்க நட்சத்திரம் (Beginner Star)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                text="முதல் வினாடி வினா அல்லது சவாலை முடிக்க வேண்டும்."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvBadge1Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="நிலை: பூட்டப்பட்டுள்ளது (Locked 🔒)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF5722"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Badge 2: Intermediate Solver -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥈 கணக்கு மேதை (Intermediate Solver)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="குறைந்தது 10 அல்லது அதற்கு மேற்பட்ட புள்ளிகளைப் பெறுக."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvBadge2Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="நிலை: பூட்டப்பட்டுள்ளது (Locked 🔒)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF5722"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Badge 3: Math Wizard -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏆 கணிதச் சக்கரவர்த்தி (Math Wizard)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 அல்லது அதற்கு மேல் புள்ளிகள் பெற்று உச்சத்தை அடையவும்."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/tvBadge3Status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="நிலை: பூட்டப்பட்டுள்ளது (Locked 🔒)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FF5722"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBadgeBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="முகப்புக்குச் செல் (Back to Home)"
            android:backgroundTint="#757575"
            android:textColor="#FFFFFF"
            android:padding="12dp" />

    </LinearLayout>
</ScrollView>
