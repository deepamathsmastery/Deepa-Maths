<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Export Math Notes as PDF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:layout_gravity="center"
        android:layout_marginBottom="20dp" />

    <!-- Instruction -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PDF-ஆக மாற்ற வேண்டிய குறிப்புகளை கீழே எழுதவும்:"
        android:textSize="14sp"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <!-- Notes Input -->
    <EditText
        android:id="@+id/etPdfContent"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:hint="எ.கா: இயற்கணிதம் பார்முலாக்கள் மற்றும் குறிப்புகள்..."
        android:gravity="top"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:layout_marginBottom="20dp" />

    <!-- Export Button -->
    <Button
        android:id="@+id/btnExportPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📄 PDF-ஆக சேமி (Export to PDF)"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Back Button -->
    <Button
        android:id="@+id/btnPdfBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="முகப்புக்குச் செல் (Back to Home)"
        android:backgroundTint="#757575"
        android:textColor="#FFFFFF"
        android:padding="12dp" />

</LinearLayout>
