<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App Logo & Welcome Header Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <!-- App Logo -->
            <ImageView
                android:id="@+id/imgAppLogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/app_logo"
                android:background="#E8EAF6"
                android:padding="4dp" />

            <!-- Welcome Text -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome, Student!"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#3F51B5"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deepa Maths Learning App"
                    android:textSize="12sp"
                    android:textColor="#666666"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CARDS CONTAINER (Using Safe LinearLayout Rows) -->

        <!-- Row 1: Home & Dashboard -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnHome"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#3F51B5">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Home" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnDashboard"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#009688">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Dashboard" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 2: Homework & Math Pad -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnHomework"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#3F51B5">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_send" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Homework" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnMathPad"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#E91E63">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_edit" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Student Math Pad" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 3: Algebra & Trigonometry -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAlgebra"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#9C27B0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Algebra" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnTrigonometry"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#673AB7">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_compass" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Trigonometry" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 4: Calculus & Coordinate Geometry -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnCalculus"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#2196F3">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Calculus" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnCoordinate"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#00BCD4">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_mapmode" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Coordinate Geometry" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 5: Video Classes & AI Lady Teacher -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnVideoTutorials"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#FF5722">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_media_play" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Video Classes" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnAiTeacher"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#795548">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_day" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="AI Lady Teacher" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 6: Quiz Game & Exam Mock Test -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnQuiz"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#607D8B">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_compass" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Quiz Game" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnExamMock"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#E91E63">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_manage" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Exam Mock Test" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 7: Voice Doubt & Offline Practice -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnVoiceDoubt"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#3F51B5">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_btn_speak_now" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Voice Doubt" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnOffline"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#4CAF50">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_save" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Offline Practice" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 8: Progress Tracker & Badges -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnProgress"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#FF9800">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_upload" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Progress Tracker" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnBadges"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#9C27B0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_send" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Badges &amp; Rewards" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 9: Daily Challenge & Math Calculator -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnDailyChallenge"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#009688">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_today" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Daily Challenge" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnCalculator"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#3F51B5">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Math Calculator" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 10: WhatsApp Doubt & Call Teacher -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnWhatsapp"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#2E7D32">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_send" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="WhatsApp Doubt" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnCall"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#C2185B">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_call" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Call Teacher" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 11: Share App & Export PDF -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="8dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnShare"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#00ACC1">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_share" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Share App" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="13sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnExportPdf"
                android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="12dp" app:cardElevation="3dp" app:cardBackgroundColor="#512DA8">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp">
                    <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@android:drawable/ic_menu_save" app:tint="#FFFFFF" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Export PDF" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="12sp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Dark Mode Switch -->
        <Switch
            android:id="@+id/switchDarkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dark Mode (இரவு முறை)"
            android:textSize="16sp"
            android:padding="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="#FFFFFF" />

        <!-- Logout Button -->
        <Button 
            android:id="@+id/btnLogout" 
            android:layout_width="match_parent" 
            android:layout_height="wrap_content" 
            android:text="Logout" 
            android:backgroundTint="#D32F2F" 
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
