<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ==================== HEADER: APP LOGO & SEO TITLE ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp"
            android:background="@drawable/circle_background"
            android:padding="12dp">

            <!-- Circle App Logo -->
            <androidx.cardview.widget.CardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardPreventCornerOverlap="false"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/imgAppLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_agenda" />
            </androidx.cardview.widget.CardView>

            <!-- SEO Title & Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlatformTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deepa Maths Mastery"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1E1B4B" />

                <TextView
                    android:id="@+id/tvPlatformSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Online Teaching Platform"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome, Student! 🎓"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#4F46E5"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Dark Mode Switch -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchDarkMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#475569" />
        </LinearLayout>

        <!-- Dashboard Action Button -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Student Dashboard"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            app:cornerRadius="12dp"
            android:layout_marginBottom="20dp"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- ==================== ROW 1: Home (Blue), Dashboard (Indigo), Homework (Purple) ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="14dp">

            <!-- Home (Blue Theme) -->
            <LinearLayout
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_blue_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_myplaces" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <!-- Dashboard (Indigo Theme) -->
            <LinearLayout
                android:id="@+id/btnDashboard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_indigo_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_manage" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dashboard" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <!-- Homework (Purple Theme) -->
            <LinearLayout
                android:id="@+id/btnHomework"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_purple_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_edit" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Homework" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== ROW 2: Math Pad (Teal), AI Teacher (Green), Quiz (Amber) ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/btnMathPad"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_teal_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_agenda" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Math Pad" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAiTeacher"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_green_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_info_details" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Teacher" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnQuiz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_amber_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/btn_star_big_on" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quiz" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== ROW 3: Voice Doubt (Red), Offline (Cyan), Progress (Deep Orange) ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/btnVoiceDoubt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_red_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/stat_notify_chat" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Voice Doubt" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnOffline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_cyan_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_save" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Offline" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnProgress"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_deep_orange_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_compass" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Progress" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== ROW 4: Badges (Pink), Challenge (Blue Grey), Calculator (Brown) ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/btnBadges"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_pink_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/btn_star_big_on" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Badges" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnDailyChallenge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_blue_grey_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_today" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Challenge" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnCalculator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_brown_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_manage" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calculator" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== ROW 5: Algebra (Violet), Trigonometry (Lime), Calculus (Light Blue) ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/btnAlgebra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_violet_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Algebra" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnTrigonometry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_emerald_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_gallery" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trigonometry" android:textSize="11sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnCalculus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_lightblue_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_mapmode" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calculus" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==================== ROW 6: Tutorials (Dark Red), WhatsApp (Forest Green), Call (Deep Purple) ==================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/btnVideoTutorials"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_darkred_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_media_play" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tutorials" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnWhatsapp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_whatsapp_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/stat_notify_chat" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="WhatsApp" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:padding="4dp">
                <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_deeppurple_circle" android:elevation="3dp">
                    <ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_gravity="center" android:src="@android:drawable/ic_menu_call" app:tint="#FFFFFF" />
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Call" android:textSize="12sp" android:textStyle="bold" android:textColor="#1F2937" android:layout_marginTop="6dp" android:gravity="center" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
