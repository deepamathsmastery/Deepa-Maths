<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="#F8F9FA"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App Logo & Welcome Header Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp"
            android:padding="8dp"
            android:background="#FFFFFF"
            android:elevation="1dp">

            <ImageView
                android:id="@+id/imgAppLogo"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/app_logo"
                android:background="#E8EAF6"
                android:padding="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Welcome, Student! 👋"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deepa Maths Learning App"
                    android:textSize="13sp"
                    android:textColor="#546E7A"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CARDS CONTAINER (Modern Material Design 3 Look) -->

        <!-- Row 1: Home & Dashboard -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnHome"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="#3F51B5" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Home" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnDashboard"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#009688" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Dashboard" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 2: Homework & Math Pad -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnHomework"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_send" app:tint="#3F51B5" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Homework" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnMathPad"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_edit" app:tint="#E91E63" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Student Math Pad" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 3: Algebra & Trigonometry -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnAlgebra"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_agenda" app:tint="#9C27B0" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Algebra" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnTrigonometry"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_compass" app:tint="#673AB7" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Trigonometry" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 4: Calculus & Coordinate Geometry -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnCalculus"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#2196F3" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Calculus" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnCoordinate"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_mapmode" app:tint="#00BCD4" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Coordinate Geometry" android:textStyle="bold" android:textColor="#333333" android:textSize="11sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 5: Video Classes & AI Lady Teacher -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnVideoTutorials"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_media_play" app:tint="#FF5722" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Video Classes" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnAiTeacher"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_day" app:tint="#795548" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="AI Lady Teacher" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 6: Quiz Game & Exam Mock Test -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnQuiz"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_compass" app:tint="#607D8B" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Quiz Game" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnExamMock"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_manage" app:tint="#E91E63" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Exam Mock Test" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 7: Voice Doubt & Offline Practice -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnVoiceDoubt"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_btn_speak_now" app:tint="#3F51B5" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Voice Doubt" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnOffline"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_save" app:tint="#4CAF50" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Offline Practice" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 8: Progress Tracker & Badges -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnProgress"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_upload" app:tint="#FF9800" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Progress Tracker" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnBadges"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_send" app:tint="#9C27B0" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Badges &amp; Rewards" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 9: Daily Challenge & Math Calculator -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnDailyChallenge"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_today" app:tint="#009688" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Daily Challenge" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnCalculator"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_sort_by_size" app:tint="#3F51B5" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Math Calculator" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 10: WhatsApp Doubt & Call Teacher -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="10dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnWhatsapp"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_send" app:tint="#2E7D32" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="WhatsApp Doubt" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnCall"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_call" app:tint="#C2185B" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Call Teacher" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Row 11: Share App & Export PDF -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginBottom="14dp">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/btnShare"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginEnd="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_share" app:tint="#00ACC1" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Share App" android:textStyle="bold" android:textColor="#333333" android:textSize="13sp" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/btnExportPdf"
                android:layout_width="0dp" android:layout_height="95dp" android:layout_weight="1" android:layout_marginStart="6dp"
                android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="1dp" app:strokeColor="#E0E0E0">
                <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:padding="8dp" android:clickable="false" android:duplicateParentState="true">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:src="@android:drawable/ic_menu_save" app:tint="#512DA8" android:duplicateParentState="true"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Export PDF" android:textStyle="bold" android:textColor="#333333" android:textSize="12sp" android:gravity="center" android:duplicateParentState="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Dark Mode Switch -->
        <Switch
            android:id="@+id/switchDarkMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dark Mode (இரவு முறை)"
            android:textSize="15sp"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:background="#FFFFFF" />

        <!-- Dashboard / Logout Button -->
        <Button 
            android:id="@+id/btnLogout" 
            android:layout_width="match_parent" 
            android:layout_height="52dp" 
            android:text="Student Dashboard" 
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#3F51B5" 
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
