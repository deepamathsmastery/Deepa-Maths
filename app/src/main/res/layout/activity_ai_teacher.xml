<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI Math Solver &amp; Doubt Assistant"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:layout_marginBottom="16dp" />

    <!-- Question Input -->
    <EditText
        android:id="@+id/etMathQuery"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:hint="உங்கள் கணிதக் கேள்வியை இங்கு டைப் செய்யவும் (எ.கா: Solve 2x + 5 = 15)"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:background="@android:drawable/editbox_background_normal"
        android:layout_marginBottom="16dp" />

    <!-- Solve Button -->
    <Button
        android:id="@+id/btnSolve"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI மூலம் தீர்வு காண் (Solve with AI)"
        android:backgroundTint="#3F51B5"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="16dp" />

    <!-- AI Response Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AI தீர்வு (Step-by-Step Solution):"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="#333333"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvAiResponse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="தீர்வு இங்கே தோன்றும்..."
            android:textSize="16sp"
            android:textColor="#333333" />
    </ScrollView>

</LinearLayout>
