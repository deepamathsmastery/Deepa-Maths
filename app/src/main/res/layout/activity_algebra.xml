<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Algebra &amp; Complex Numbers"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Basic Identities -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="14dp" android:layout_marginBottom="12dp" android:elevation="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Basic Algebraic Identities" android:textSize="16sp" android:textStyle="bold" android:textColor="#D32F2F" android:layout_marginBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="• (a + b)² = a² + 2ab + b²\n• (a - b)² = a² - 2ab + b²\n• a² - b² = (a - b)(a + b)\n• (a + b)³ = a³ + b³ + 3ab(a + b)\n• (a - b)³ = a³ - b³ - 3ab(a - b)\n• a³ + b³ = (a + b)(a² - ab + b²)\n• a³ - b³ = (a - b)(a² + ab + b²)" android:textSize="14sp" android:textColor="#333333" android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- Quadratic Equations -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="14dp" android:layout_marginBottom="12dp" android:elevation="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2. Quadratic Equations" android:textSize="16sp" android:textStyle="bold" android:textColor="#D32F2F" android:layout_marginBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="• Standard Form: ax² + bx + c = 0\n• Roots Formula: x = (-b ± √(b² - 4ac)) / 2a\n• Discriminant (D) = b² - 4ac\n• Sum of Roots (α + β) = -b / a\n• Product of Roots (αβ) = c / a" android:textSize="14sp" android:textColor="#333333" android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- AP & GP -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="14dp" android:layout_marginBottom="12dp" android:elevation="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3. Progressions (AP &amp; GP)" android:textSize="16sp" android:textStyle="bold" android:textColor="#D32F2F" android:layout_marginBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="• AP n-th Term: an = a + (n - 1)d\n• AP Sum of n terms: Sn = (n/2)[2a + (n - 1)d]\n• GP n-th Term: an = a × r^(n-1)\n• GP Sum of n terms: Sn = a(r^n - 1) / (r - 1)" android:textSize="14sp" android:textColor="#333333" android:lineSpacingExtra="4dp"/>
        </LinearLayout>

        <!-- Complex Numbers -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="#FFFFFF" android:padding="14dp" android:layout_marginBottom="16dp" android:elevation="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="4. Complex Numbers (11th/12th/JEE)" android:textSize="16sp" android:textStyle="bold" android:textColor="#D32F2F" android:layout_marginBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="• Standard Form: z = x + iy\n• i² = -1\n• Modulus |z| = √(x² + y²)\n• Conjugate z̄ = x - iy\n• De Moivre's Theorem: (cosθ + isinθ)^n = cos(nθ) + isin(nθ)" android:textSize="14sp" android:textColor="#333333" android:lineSpacingExtra="4dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
