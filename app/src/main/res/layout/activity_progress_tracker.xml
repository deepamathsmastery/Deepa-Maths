<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Student Progress Tracker &amp; Analytics"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Card / Container for Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <!-- Quiz Score Display -->
        <TextView
            android:id="@+id/tvQuizScoreStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="மின்னஞ்சல் வினாடி வினா மதிப்பெண்: 0"
            android:textSize="16sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Math Pad Solved Count -->
        <TextView
            android:id="@+id/tvMathPadStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="தீர்க்கப்பட்ட கணக்குகள்: 0"
            android:textSize="16sp"
            android:textColor="#333333"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Overall Status -->
        <TextView
            android:id="@+id/tvOverallPerformance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="திறமை நிலை: தொடக்கநிலை (Beginner)"
            android:textSize="16sp"
            android:textColor="#4CAF50"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Reset / Clear Progress Button -->
    <Button
        android:id="@+id/btnResetProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="புள்ளிவிவரங்களை மீட்டமை (Reset Stats)"
        android:backgroundTint="#FF5722"
        android:textColor="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="12dp" />

    <!-- Back Button -->
    <Button
        android:id="@+id/btnProgressBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="முகப்புக்குச் செல் (Back to Home)"
        android:backgroundTint="#757575"
        android:textColor="#FFFFFF"
        android:padding="12dp" />

</LinearLayout>
