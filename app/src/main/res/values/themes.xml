<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- DayNight Theme - மாணவர்களுக்கான பிரீமியம் எஜுகேஷன் லுக் -->
    <style name="Theme.DeepaMaths" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- பிரதான பிராண்ட் நிறம் (Modern Indigo - மாணவர்களுக்கு பிடித்தமான நிறம்) -->
        <item name="colorPrimary">#3F51B5</item>
        <item name="colorPrimaryVariant">#303F9F</item>
        <item name="colorOnPrimary">@android:color/white</item>

        <!-- செகண்டரி நிறம் (Teal / Vibrant Green - வெற்றிகள் மற்றும் பட்டன்களுக்கு) -->
        <item name="colorSecondary">#009688</item>
        <item name="colorSecondaryVariant">#00796B</item>
        <item name="colorOnSecondary">@android:color/white</item>

        <!-- ஸ்டேட்டஸ் பார் மற்றும் நேவிகேஷன் பார் நிறங்கள் (Modern Immersive Look) -->
        <item name="android:statusBarColor">#303F9F</item>
        <item name="android:navigationBarColor">#F8F9FA</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- ஆப் பேக்ரவுண்ட் நிறம் -->
        <item name="android:windowBackground">#F8F9FA</item>
    </style>
</resources>
